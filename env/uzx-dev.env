UZX_ENABLE_SLIPPAGE_GUARD=1
UZX_MAX_SLIPPAGE_BPS=25
UZX_MAX_ORDER_QTY=0.5
UZX_MAX_ORDER_NOTIONAL=1000
UZX_MAX_ORDERS_PER_SECOND=1
UZX_MARKET_TRADE_CCY=quote
UZX_MARKET_REF_PRICE=bbo

# enable rounding (defaults to on below; set to 0 to disable)
UZX_ENABLE_ROUNDING=1

# rounding mode for amount and price (floor is safest for takers)
UZX_ROUND_AMOUNT=floor   # floor | nearest
UZX_ROUND_PRICE=floor    # floor | nearest

# backfill on by default; set to 0 to disable
UZX_ENABLE_FILL_BACKFILL=1

# JSON logs on (pretty easy to grep/ship)
UZX_LOG_JSON=1
# Log level for the connector logger (DEBUG|INFO|WARNING)
UZX_LOG_LEVEL=DEBUG
# Optional run/session id (helps group logs by run)
UZX_RUN_ID="$(date +%Y%m%d-%H%M%S)"

# enable/disable kill switch
UZX_ENABLE_KILL_SWITCH=1

# manual kill: if this file exists inside the container, trading pauses
UZX_KILL_SIGNAL_FILE=/app/.kill

# circuit breakers
UZX_MAX_CONSECUTIVE_ERRORS=5          # pause after N back-to-back submit/status errors
UZX_MAX_OPEN_ORDERS=50                # pause if active open orders exceed this
UZX_MAX_SESSION_NOTIONAL=50000        # pause after sending this much notional (quote) in the current run

# (optional) log level you already set
UZX_LOG_LEVEL=DEBUG
